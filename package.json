{
  "name": "invictus-bracket",
  "version": "0.1.0",
  "description": "Headless single-elimination bracket engine and layout geometry. Seeding, byes, two-leg ties, winner propagation, plus card and connector coordinates you render yourself.",
  "keywords": [
    "bracket",
    "tournament",
    "knockout",
    "single-elimination",
    "seeding",
    "headless"
  ],
  "license": "MIT",
  "author": "Oraz Chollayev",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./layout": {
      "import": {
        "types": "./dist/layout.d.ts",
        "default": "./dist/layout.js"
      },
      "require": {
        "types": "./dist/layout.d.cts",
        "default": "./dist/layout.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
